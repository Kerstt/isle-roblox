--!strict
local TestKit = require(script.Parent.TestKit)

local NAN = 0 / 0
local INF = math.huge

return function(t: TestKit.Context)
	local Check = t.load("Modules/Lib/Check")
	local expect = t.expect

	t.describe("Check.isFinite", function()
		t.it("accepts ordinary numbers", function()
			expect(Check.isFinite(0)).toBe(true)
			expect(Check.isFinite(-12.5)).toBe(true)
		end)
		t.it("rejects NaN, +inf, -inf and non-numbers", function()
			expect(Check.isFinite(NAN)).toBe(false)
			expect(Check.isFinite(INF)).toBe(false)
			expect(Check.isFinite(-INF)).toBe(false)
			expect(Check.isFinite("1")).toBe(false)
			expect(Check.isFinite(nil)).toBe(false)
		end)
	end)

	t.describe("Check.boolean", function()
		local isBoolean = Check.boolean()
		t.it("accepts true and false", function()
			expect(isBoolean(true)).toBe(true)
			expect(isBoolean(false)).toBe(true)
		end)
		t.it("rejects nil, numbers and strings", function()
			expect(isBoolean(nil)).toBe(false)
			expect(isBoolean(1)).toBe(false)
			expect(isBoolean("true")).toBe(false)
		end)
	end)

	t.describe("Check.integer", function()
		local slot = Check.integer(1, 6)
		t.it("accepts whole numbers inside the range, including both ends", function()
			expect(slot(1)).toBe(true)
			expect(slot(3)).toBe(true)
			expect(slot(6)).toBe(true)
		end)
		t.it("rejects values outside the range", function()
			expect(slot(0)).toBe(false)
			expect(slot(7)).toBe(false)
			expect(slot(-1)).toBe(false)
		end)
		t.it("rejects fractions", function()
			expect(slot(1.5)).toBe(false)
			expect(slot(5.999)).toBe(false)
		end)
		t.it("rejects NaN and infinities", function()
			expect(slot(NAN)).toBe(false)
			expect(slot(INF)).toBe(false)
			expect(slot(-INF)).toBe(false)
			expect(Check.integer(-1e300, 1e300)(INF)).toBe(false)
		end)
		t.it("rejects numeric strings, tables and nil", function()
			expect(slot("2")).toBe(false)
			expect(slot({})).toBe(false)
			expect(slot(nil)).toBe(false)
		end)
		t.it("throws on bad bounds when the checker is built", function()
			expect(function()
				Check.integer(5, 1)
			end).toThrow("min must be <= max")
			expect(function()
				Check.integer(NAN, 1)
			end).toThrow("finite")
		end)
	end)

	t.describe("Check.number", function()
		local volume = Check.number(0, 1)
		t.it("accepts fractions inside the range", function()
			expect(volume(0)).toBe(true)
			expect(volume(0.5)).toBe(true)
			expect(volume(1)).toBe(true)
		end)
		t.it("rejects values outside the range", function()
			expect(volume(-0.01)).toBe(false)
			expect(volume(1.01)).toBe(false)
		end)
		t.it("rejects NaN and infinities even with a huge range", function()
			local wide = Check.number(-1e300, 1e300)
			expect(wide(NAN)).toBe(false)
			expect(wide(INF)).toBe(false)
			expect(wide(-INF)).toBe(false)
			expect(volume(NAN)).toBe(false)
		end)
		t.it("rejects non-numbers", function()
			expect(volume("0.5")).toBe(false)
			expect(volume(true)).toBe(false)
		end)
	end)

	t.describe("Check.string", function()
		local inviteId = Check.string(8)
		t.it("accepts strings up to the max length", function()
			expect(inviteId("")).toBe(true)
			expect(inviteId("abcdefgh")).toBe(true)
		end)
		t.it("rejects strings over the max length", function()
			expect(inviteId("abcdefghi")).toBe(false)
		end)
		t.it("enforces a minimum length when given", function()
			local name = Check.string(10, 2)
			expect(name("a")).toBe(false)
			expect(name("ab")).toBe(true)
		end)
		t.it("rejects invalid UTF-8", function()
			expect(inviteId("\255\254")).toBe(false)
		end)
		t.it("measures length in bytes, not characters", function()
			local word = "h\195\169llo" -- "héllo": 5 characters, 6 bytes
			expect(#word).toBe(6)
			expect(Check.string(5)(word)).toBe(false)
			expect(Check.string(6)(word)).toBe(true)
		end)
		t.it("rejects non-strings", function()
			expect(inviteId(12)).toBe(false)
			expect(inviteId(nil)).toBe(false)
		end)
	end)

	t.describe("Check.enum", function()
		local pingType = Check.enum({ 1, 2, 3 })
		local slotName = Check.enum({ "skin", "effect" })
		t.it("accepts listed values", function()
			expect(pingType(2)).toBe(true)
			expect(slotName("skin")).toBe(true)
		end)
		t.it("rejects unlisted values, NaN and nil", function()
			expect(pingType(4)).toBe(false)
			expect(pingType("2")).toBe(false)
			expect(pingType(NAN)).toBe(false)
			expect(slotName("Skin")).toBe(false)
			expect(slotName(nil)).toBe(false)
		end)
		t.it("throws on an empty list", function()
			expect(function()
				Check.enum({})
			end).toThrow("non-empty")
		end)
	end)

	t.describe("Check.vector3", function()
		-- Lune's Vector3 comes from @lune/roblox; skip if this Lune build reports another typeof name.
		if typeof(Vector3.new(0, 0, 0)) ~= "Vector3" then
			t.skip("Vector3 checks", "Vector3 is not available in this runner")
			return
		end
		local inMap = Check.vector3(Vector3.new(-100, -10, -100), Vector3.new(100, 50, 100))
		t.it("accepts finite vectors inside the bounds, including the edges", function()
			expect(inMap(Vector3.new(1, 2, 3))).toBe(true)
			expect(inMap(Vector3.new(0, 0, 0))).toBe(true)
			expect(inMap(Vector3.new(100, 50, -100))).toBe(true)
		end)
		t.it("rejects NaN and infinite components", function()
			expect(inMap(Vector3.new(NAN, 0, 0))).toBe(false)
			expect(inMap(Vector3.new(0, INF, 0))).toBe(false)
			expect(inMap(Vector3.new(0, 0, -INF))).toBe(false)
		end)
		t.it("rejects vectors outside the bounds", function()
			expect(inMap(Vector3.new(101, 0, 0))).toBe(false)
			expect(inMap(Vector3.new(0, -11, 0))).toBe(false)
			expect(inMap(Vector3.new(0, 0, 100.5))).toBe(false)
		end)
		t.it("rejects tables that only look like vectors", function()
			expect(inMap({ X = 1, Y = 2, Z = 3 })).toBe(false)
			expect(inMap(nil)).toBe(false)
		end)
		t.it("throws on missing, non-finite or inverted bounds", function()
			local low, high = Vector3.new(-1, -1, -1), Vector3.new(1, 1, 1)
			expect(function()
				Check.vector3(nil :: any, nil :: any)
			end).toThrow("bounds required")
			expect(function()
				Check.vector3(low, nil :: any)
			end).toThrow("bounds required")
			expect(function()
				Check.vector3(Vector3.new(-INF, -1, -1), high)
			end).toThrow("finite")
			expect(function()
				Check.vector3(low, Vector3.new(1, NAN, 1))
			end).toThrow("finite")
			expect(function()
				Check.vector3(Vector3.new(-1, -1, 2), high)
			end).toThrow("(Z)")
		end)
	end)

	t.describe("Check.instanceUnder", function()
		-- Studio has real Instances; Lune gets them from @lune/roblox when that build provides them.
		local function instancesWork(): boolean
			return typeof(Instance.new("Folder")) == "Instance"
		end
		local ok, works = pcall(instancesWork)
		if not (ok and works) then
			t.skip("instanceUnder", "Instances are not available in this runner")
			return
		end
		local root = Instance.new("Folder")
		local child = Instance.new("Part")
		child.Parent = root
		local outsider = Instance.new("Part")
		local isUnderRoot = Check.instanceUnder(root)
		t.it("accepts descendants", function()
			expect(isUnderRoot(child)).toBe(true)
		end)
		t.it("rejects the ancestor itself, outsiders and non-instances", function()
			expect(isUnderRoot(root)).toBe(false)
			expect(isUnderRoot(outsider)).toBe(false)
			expect(isUnderRoot({ Parent = root })).toBe(false)
			expect(isUnderRoot(nil)).toBe(false)
		end)
		root:Destroy()
		outsider:Destroy()
	end)

	t.describe("Check.optional", function()
		local maybeItem = Check.optional(Check.string(4))
		t.it("accepts nil or a value the inner checker accepts", function()
			expect(maybeItem(nil)).toBe(true)
			expect(maybeItem("abc")).toBe(true)
		end)
		t.it("rejects values the inner checker rejects", function()
			expect(maybeItem("abcde")).toBe(false)
			expect(maybeItem(5)).toBe(false)
		end)
		t.it("is reported by isOptional, plain checkers are not", function()
			expect(Check.isOptional(maybeItem)).toBe(true)
			expect(Check.isOptional(Check.boolean())).toBe(false)
		end)
	end)
end
